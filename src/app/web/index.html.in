<!doctype html>
<!-- ui-flow web build: the page that loads the WebAssembly app (configured by CMake). -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <!-- 1 CSS pixel = 1 Qt device-independent pixel -->
  <meta name="viewport" content="width=device-width, height=device-height, user-scalable=0">
  <title>ui-flow</title>
  <meta name="description" content="Map how the screens of an app connect: drop screenshots, mark what can be clicked, draw the flow, then click through it.">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <style>
    html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #F5F5F5; }
    #screen { width: 100%; height: 100%; display: none; }
    #loading {
      height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 14px; padding: 0 16px; box-sizing: border-box; text-align: center;
      font: 13px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; color: #6B6B6B;
    }
    #loading img { width: 64px; height: 64px; }
    #loading h1 { margin: 0; font-size: 20px; font-weight: 600; color: #1E1E1E; }
    .bar { width: 180px; height: 3px; border-radius: 2px; background: #E6E6E6; overflow: hidden; }
    .bar::after {
      content: ""; display: block; width: 40%; height: 100%; border-radius: 2px; background: #0D99FF;
      animation: slide 1.1s ease-in-out infinite;
    }
    @keyframes slide { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
    #loading.failed .bar { display: none; }
    #loading.failed #status { color: #F24822; max-width: 420px; }
    #help { display: none; color: #0D99FF; text-decoration: none; }
    #help:hover { text-decoration: underline; }
    #loading.failed #help { display: block; }
    .version { color: #A6A6A6; font-size: 11px; }
  </style>
</head>
<body>
  <div id="loading">
    <img src="favicon.svg" alt="">
    <h1>ui-flow</h1>
    <div class="bar"></div>
    <div id="status">Loading…</div>
    <a id="help" href="https://github.com/miranda1000/ui-flow/issues" target="_blank" rel="noopener">Need help? Report it on GitHub</a>
    <div class="version">@UIFLOW_VERSION_STRING@</div>
    <noscript>ui-flow needs JavaScript.</noscript>
  </div>
  <div id="screen"></div>

  <script src="@UIFLOW_EXE_NAME@.js"></script>
  <script src="qtloader.js"></script>
  <script>
    (async () => {
      const loading = document.getElementById('loading');
      const screen = document.getElementById('screen');
      const status = document.getElementById('status');
      const hasWebGL = () => {
        try { return !!document.createElement('canvas').getContext('webgl2'); } catch (e) { return false; }
      };
      const fail = (text) => {
        loading.classList.add('failed');
        loading.style.display = '';
        screen.style.display = 'none';
        status.textContent = text;
      };
      // Qt keeps the keyboard focus in a helper element of its window, but a click on the
      // canvas moves the browser's focus to the page body and keys (shortcuts) no longer reach
      // the app. Hand it back unless Qt focused something itself (a text field's input).
      screen.addEventListener('pointerup', () => setTimeout(() => {
        if (document.activeElement && document.activeElement !== document.body)
          return;
        const root = document.getElementById('qt-shadow-container')?.shadowRoot;
        root?.querySelector('.qt-window-focus-helper')?.focus({ preventScroll: true });
      }), { capture: true });  // Qt stops the event's propagation

      if (location.protocol === 'file:') {
        fail('Browsers do not run WebAssembly from a file opened directly. Serve this folder over HTTP, '
             + 'e.g. run "python3 -m http.server" in it and open http://localhost:8000.');
        return;
      }
      try {
        await qtLoad({
          qt: {
            entryFunction: window.@UIFLOW_WEB_ENTRY@,
            containerElements: [screen],
            onLoaded: () => {
              loading.style.display = 'none';
              screen.style.display = 'block';
            },
            onExit: (exit) => fail(hasWebGL()
              ? 'ui-flow stopped' + (exit.text ? ': ' + exit.text : '.')
              : 'ui-flow needs WebGL, which this browser has turned off. Enable hardware acceleration '
                + 'in the browser settings (or try another browser) and reload the page.'),
          },
        });
      } catch (e) {
        console.error(e);
        fail('ui-flow could not start in this browser. It needs a current version of Chrome, Edge, Firefox or Safari.');
      }
    })();
  </script>
</body>
</html>
